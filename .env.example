# Local: copy to .env.local (and .env for scripts). Railway: use variable references as shown.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/learncrew   # Railway: ${{postgres.DATABASE_URL}}
AUTH_SECRET=                      # openssl rand -base64 32
AUTH_URL=http://localhost:3000    # Railway: https://${{RAILWAY_PUBLIC_DOMAIN}}
AUTH_TRUST_HOST=true
AUTH_RESEND_KEY=                  # empty => magic links are logged to the server console
EMAIL_FROM=LearnCrew <no-reply@yourdomain.in>
ANTHROPIC_API_KEY=                # optional at runtime; required for scripts/generate.ts
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SMART=claude-sonnet-5-5
ANTHROPIC_MODEL_BEST=claude-opus-5-5
VOYAGE_API_KEY=                   # optional
APP_BASE_URL=http://localhost:3000
CRON_SECRET=dev-cron-secret
SUPERADMIN_EMAIL=founder@learncrew.in
REDIS_URL=                        # optional, skip until >1,000 actives
NODE_ENV=development
