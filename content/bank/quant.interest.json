 {"id": "Q-QNT-INT-0001", "section": "quant", "topic": "interest", "subtopic": "simple_interest", "stem": "What is the simple interest on ₹8,000 at 6% per annum for 3 years?", "options": ["₹1,520", "₹1,280", "₹1,440", "₹1,600"], "answer_index": 2, "explanation": "SI = P × R × T / 100 = 8,000 × 6 × 3 / 100 = ₹1,440.", "shortcut": "SI = PRT/100", "company_tags": ["wipro", "cognizant"], "difficulty": 1, "time_sec": 40, "source": "seed", "seed_id": null, "status": "golden", "variant_group": "INT-SI-01", "version": 1},
 {"id": "Q-QNT-INT-0002", "section": "quant", "topic": "interest", "subtopic": "simple_interest", "stem": "A sum of money doubles itself in 8 years at simple interest. What is the rate of interest per annum?", "options": ["12.5%", "8%", "10%", "25%"], "answer_index": 0, "explanation": "Doubling means SI = P in 8 years. P = P × R × 8/100 → R = 100/8 = 12.5% per annum.", "shortcut": "Rate = 100/(years to double) for SI", "company_tags": ["tcs_nqt", "capgemini"], "difficulty": 2, "time_sec": 50, "source": "seed", "seed_id": null, "status": "golden", "variant_group": "INT-SI-02", "version": 1},
 {"id": "Q-QNT-INT-0003", "section": "quant", "topic": "interest", "subtopic": "compound_interest", "stem": "What is the compound interest on ₹16,000 for 1 year at 10% per annum, compounded half-yearly?", "options": ["₹1,600", "₹1,640", "₹1,680", "₹1,620"], "answer_index": 1, "explanation": "Half-yearly: rate 5% per half-year, 2 periods. Amount = 16,000 × 1.05 × 1.05 = 16,800 × 1.05 = ₹17,640. CI = 17,640 − 16,000 = ₹1,640.", "shortcut": "Halve the rate, double the periods", "company_tags": ["tcs_nqt", "infosys"], "difficulty": 3, "time_sec": 70, "source": "seed", "seed_id": null, "status": "golden", "variant_group": "INT-CI-01", "version": 1},
 {"id": "Q-QNT-INT-0004", "section": "quant", "topic": "interest", "subtopic": "si_ci_difference", "stem": "The difference between the compound interest and the simple interest on a sum for 2 years at 5% per annum is ₹25. What is the sum?", "options": ["₹5,000", "₹12,500", "₹20,000", "₹10,000"], "answer_index": 3, "explanation": "For 2 years, CI − SI = P × (R/100)². So 25 = P × (5/100)² = P/400, giving P = ₹10,000.", "shortcut": "2-year CI − SI = P(R/100)²", "company_tags": ["accenture", "cognizant"], "difficulty": 3, "time_sec": 70, "source": "seed", "seed_id": null, "status": "golden", "variant_group": "INT-DIFF-01", "version": 1},
 {"id": "Q-QNT-INT-0005", "section": "quant", "topic": "interest", "subtopic": "compound_interest", "stem": "A sum invested at compound interest (compounded annually) amounts to ₹8,820 in 2 years and ₹9,261 in 3 years. What is the sum?", "options": ["₹8,000", "₹8,400", "₹7,600", "₹8,100"], "answer_index": 0, "explanation": "Interest in year 3 = 9,261 − 8,820 = ₹441, earned on ₹8,820, so rate = 441/8,820 = 5%. Then P × 1.05² = 8,820 → P = 8,820 ÷ 1.1025 = ₹8,000.", "shortcut": "Rate = (A₃ − A₂)/A₂; then divide back", "company_tags": ["tcs_nqt", "infosys"], "difficulty": 4, "time_sec": 95, "source": "seed", "seed_id": null, "status": "golden", "variant_group": "INT-CI-02", "version": 1},
 {"id": "Q-QNT-INT-0006", "section": "quant", "topic": "interest", "subtopic": "si_ci_difference", "stem": "The difference between the compound interest (compounded annually) and the simple interest on a sum for 3 years at 10% per annum is ₹93. What is the sum?", "options": ["₹3,100", "₹4,650", "₹3,000", "₹9,300"], "answer_index": 2, "explanation": "On ₹100: SI for 3 years = 30; CI = 100 × 1.1³ − 100 = 33.1. Difference = 3.1 per ₹100. So sum = 93 × 100/3.1 = ₹3,000.", "shortcut": "3-year CI − SI = P(R/100)²(3 + R/100)", "company_tags": ["tcs_nqt", "accenture"], "difficulty": 5, "time_sec": 120, "source": "seed", "seed_id": null, "status": "golden", "variant_group": "INT-DIFF-02", "version": 1}
